# ── generated / rebuildable ─────────────────────────────────────────────
# The database is derived from catalog.py + store.py. Rebuild it with:
#   python store.py --force
data/*.db
data/*.db-wal
data/*.db-shm
*.db.bak
*.db.bak-wal
*.db.bak-shm
__pycache__/
*.pyc
logs/

# ── credentials — never commit ──────────────────────────────────────────
# users.json holds salted password hashes for named accounts;
# .session-secret signs live sessions. Both are per-install.
data/users.json
data/users.json.bak*
data/.session-secret

# ── test artefacts ──────────────────────────────────────────────────────
# tests/_out/chromeprof is a throwaway Chrome profile (~12 MB, includes
# Cookies and Login Data). Regenerated by tests/v3check.py on each run.
tests/_out/
