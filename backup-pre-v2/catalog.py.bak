#!/usr/bin/env python3
"""ZD Arch & Design — the workflow catalog, transcribed from the source documents.

WHAT THIS IS
  Volume 1 of the Design Workflow Booklet defines 39 workflows across four teams
  (Architecture, MEP, Structure, Creative) as ~277 ordered process steps, each with
  a duration, a lane (who does it), and — in the swimlanes — maker/checker marks and
  "Changes Required" rework arrows.

  This module is that book as data. Everything downstream (plans, tasks, the SLA
  baseline, the stage matrix) is derived from here, so the booklet is the single
  source of truth rather than something a person retypes into a sheet.

THE TWO TAT SOURCES, AND WHY BOTH ARE KEPT
  The Design & Architecture Guidelines Manual §4.0 also publishes an overall TAT per
  stage, and it DISAGREES with the booklet on 6 of the 10 architecture stages. It
  also disagrees with its own embedded flowcharts on Stages 5, 11 and 12. The worst
  case is Design Schematics: the same flowchart is captioned "8-9 Weeks" in the
  booklet and "4-6 Weeks" in the Manual.

  We do not silently pick a winner. Both are stored (`tat_booklet`, `tat_manual`) and
  a workflow where they differ is flagged. The dashboard shows the conflict rather
  than hiding it, because an SLA nobody agrees on is worse than no SLA. Ahmed Khan
  rules on which is canonical; `TAT_SOURCE` below is the one switch that applies it.

ON `None` DURATIONS
  Topographical Survey and In-house Structural Stability Ownership have a completely
  blank duration column in the booklet. Several steps are marked "*" (variable —
  depends on an external party) or "same day". None means genuinely unknown and is
  rendered as "—", never as zero, because a zero would quietly deflate every rollup.

FLAGS
  M  maker      the step has a maker mark in the swimlane
  C  checker    the step has a checker mark — a review/decision point
  R  rework     a "Changes Required" arrow leaves this step and loops back
  X  external   duration depends on a party outside ZD (the "*" in the booklet)
  G  gate       nothing downstream may start until this closes
"""

# The one switch. "booklet" | "manual" — which overall TAT is the SLA baseline.
# Until Ahmed rules, the booklet wins: its per-step durations are the only ones that
# actually sum, so it is the only source that can be validated against itself.
TAT_SOURCE = "booklet"

# ── the spine ────────────────────────────────────────────────────────────────
# Three phases. The Manual numbers the design stages 3-12; §3 covers acquisition
# (stages 1-2) and §§5-18 cover construction support, which has no stage number at
# all but is unambiguously this department's work and runs for years. So the spine
# carries 1-2 and 13 explicitly rather than leaving the team invisible either side
# of the design window.
STAGES = [
    (1,  "Data Gathering",          "A", "Intake from Acquisition / Legal / Sales"),
    (2,  "Feasibility & Approval",  "A", "EPC vs IRR, management gate"),
    (3,  "Design Schematics",       "B", "Site, bylaws, zoning, concept, massing"),
    (4,  "Internal Coordination",   "B", "Column grid and MEP services into the layout"),
    (5,  "Design Development",      "B", "Layouts, elevations, sections, inventory"),
    (6,  "3D Development",          "B", "Modelling, rendering, 4K exteriors"),
    (7,  "Authority Submission",    "B", "LDA submission and feedback"),
    (8,  "Mood Board",              "B", "Theme and material direction"),
    (9,  "Marketing Collateral",    "B", "Sales kit, renders, brochure, logo"),
    (10, "Tender Drawings",         "B", "Enough detail for contractors to bid"),
    (11, "IFC Phase I & II",        "B", "Issued for construction — grey structure"),
    (12, "IFC Phase III",           "B", "Interiors and finishing"),
    (13, "Construction Support",    "C", "RFIs, MAR, shop drawings, site visits, as-built"),
]
PHASES = {"A": "Acquisition", "B": "Design", "C": "Construction Support"}

TEAMS = ["Architecture", "Structure", "MEP", "Creative"]

# Lanes that are NOT one of the four teams. Work is attributed to them and they
# hold the clock, but they never sign in — exactly the pattern PULSE already uses
# for its approval departments. Splitting these out is what makes "waiting on
# someone else" measurable instead of being charged to the team as idle time.
EXTERNAL_LANES = [
    "PM", "Supply Chain", "Finance", "Legal", "Property Mgmt", "CPML",
    "Call Center", "Production", "Design Team", "Third Party Vendor",
    "Authority", "Zameen Studios", "Bayut", "Stakeholders", "Higher Management",
]

