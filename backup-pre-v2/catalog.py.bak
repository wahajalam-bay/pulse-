def flatten():
    """One row per process step — what the importer writes to `products`."""
    out = []
    for team, wf, stage, tb, tm, steps in CATALOG:
        for seq, name, days, lane, flags in steps:
            out.append({
                "team": team, "workflow": wf, "stage": stage,
                "seq": seq, "step": name, "tat_days": days,
                "lane": lane or team, "is_external": bool(lane and lane not in TEAMS),
                "maker": "M" in flags, "checker": "C" in flags,
                "rework": "R" in flags, "variable": "X" in flags, "gate": "G" in flags,
                "tat_booklet": tb, "tat_manual": tm,
            })
    return out


def conflicts():
    """Workflows where the booklet and the Manual publish different overall TATs.

    Surfaced on screen rather than resolved in code — see the module docstring.
    """
    out = []
    for team, wf, stage, tb, tm, steps in CATALOG:
        if tm and tb and tm.strip() != tb.strip():
            out.append({"team": team, "workflow": wf, "stage": stage,
                        "booklet": tb, "manual": tm})
    return out


def stats():
    rows = flatten()
    return {
        "workflows": len(CATALOG),
        "steps": len(rows),
        "teams": len(TEAMS),
        "external_steps": sum(1 for r in rows if r["is_external"]),
        "rework_points": sum(1 for r in rows if r["rework"]),
        "gates": sum(1 for r in rows if r["gate"]),
        "unknown_tat": sum(1 for r in rows if r["tat_days"] is None),
        "tat_conflicts": len(conflicts()),
    }


if __name__ == "__main__":
    import json
    print(json.dumps(stats(), indent=2))
    print("\nTAT conflicts (booklet vs manual):")
    for c in conflicts():
        print(f"  Stage {c['stage']:>2}  {c['workflow']:<38} {c['booklet']:>12}  vs  {c['manual']}")
